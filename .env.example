# Copy this file to `.env.local` for local development, and add the same
# variables in Vercel (Project → Settings → Environment Variables) for production.

# Supabase → Project Settings → API → "Project URL"
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API → "anon public" key (also called the
# "publishable" key in newer dashboards). It is safe to expose in the browser:
# Row Level Security decides what it can read or write.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# The public address of the website. Used for sitemap.xml, social previews and
# password-reset links. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NEVER put the Supabase "service_role" key in this project. The app does not
# need it, and it would bypass every security rule if it leaked.
